# Lumovia — environment variables
#
# Copy this file to .env.local and fill in real values. Only the TMDB
# credentials are strictly required for the app to boot (see
# src/lib/env.ts) — everything else degrades gracefully when unset:
# no Supabase = no accounts/watchlists/comments, no Upstash = no edge
# caching/rate-limit persistence (falls back to in-memory), no Cloudflare =
# TMDB calls go direct instead of through the edge-cache worker.
#
# Never commit .env.local — it's gitignored. This file (.env.example) is
# the only one meant to be committed, and it must never contain real values.

# ── Site ────────────────────────────────────────────────────────────────
# Your public site URL. Used for canonical tags, sitemaps, JSON-LD, OG
# images, and Server Actions origin checks. Set this to wherever the site
# is actually reachable publicly (your domain, or a Vercel/Worker URL).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── TMDB (movie / TV metadata) — REQUIRED ───────────────────────────────
# Get both free at https://www.themoviedb.org/settings/api
# Either one alone is sufficient; having both lets the app fall back.
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# ── Supabase (accounts, watchlists, ratings, comments, RLS) — optional ──
# Create a free project at https://supabase.com, then run every file in
# supabase/migrations/ in order (via the SQL editor or the Management API —
# see the comment above SUPABASE_ACCESS_TOKEN below for how this project
# applies them without the CLI).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Management API personal access token (https://supabase.com/dashboard/account/tokens).
# Only needed for running migrations via scripts — the running app never
# reads this; it's an operator/deploy-time credential, not an app secret.
SUPABASE_ACCESS_TOKEN=

# ── Upstash Redis (edge cache + rate limiting) — optional ──────────────
# Free database at https://console.upstash.com — use the REST credentials,
# not a redis:// connection string.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare (edge-cache worker + API-cache worker) — optional ───────
# Only needed if you deploy the Workers in workers/ (cache-proxy.js,
# api-cache/worker.js) as an edge layer in front of the app. Skip entirely
# if you're deploying straight to Vercel or another platform with its own
# CDN — the app works fine without a Cloudflare layer, just without the
# extra edge cache tier.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Origin URL the cache-proxy Worker forwards to (your deployed app).
API_CACHE_URL=

# ── Cloudflare R2 (optional object storage) ─────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# ── Self-defined shared secrets — generate your own random strings ─────
# e.g. `openssl rand -hex 32` for each. Never reuse an example value.
CRON_SECRET=
ADMIN_API_KEY=
CACHE_WARM_SECRET=
WORKER_KEY=
# Comma-separated emails allowed to use admin-only features.
ADMIN_EMAILS=

# ── Embed-provider API key (server-side only, never sent to the client) ─
NEXSTREAM_API_KEY=

# ── Ad networks — all optional, ads are simply skipped when unset ──────
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSTERRA_ID=
NEXT_PUBLIC_POPADS_ID=
NEXT_PUBLIC_PROPELLERADS_ID=
NEXT_PUBLIC_INTELLIGENCEADX_ID=

# ── Debug — leave off in production ─────────────────────────────────────
# Wraps every outbound fetch and logs it. Real, measurable overhead on
# every request. Only for local traffic debugging.
FLOW_DEBUG=0
